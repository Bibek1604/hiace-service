{
  "name": "sajilo-yatra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "prisma validate && prisma generate && tsc --noEmit && eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration.ts tests/tenancy.ts tests/segments.ts tests/crud.ts tests/cancellation.ts tests/driver-portal.ts",
    "test:api": "tsx --test --test-timeout=120000 tests/api.e2e.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run test:integration && npm run build && npm run test:api && npm run test:e2e",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "worker": "tsx scripts/expire-worker.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:local": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "db:reset": "node scripts/local-db.mjs reset && prisma migrate deploy && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "5.104.4",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "jose": "6.1.3",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "nodemailer": "^7.0.13",
    "prisma": "6.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.34.5",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
