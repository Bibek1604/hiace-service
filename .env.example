# ---- Database (PostgreSQL 15+ with the btree_gist extension) ----
# Local: docker compose up -d db   -> postgresql://booking:booking@localhost:5432/booking
# Hosted: use the provider's pooled connection string and make sure this server's IP is allowed through its firewall.
DATABASE_URL="postgresql://booking:booking@localhost:5432/booking?schema=public&connect_timeout=5"

# ---- Application ----
# Exact public origin of the site; browsers must send it on every write (CSRF protection).
APP_ORIGIN="http://localhost:3000"
# At least 32 random characters. Signs sessions, booking links and tickets.
SESSION_SECRET="replace-with-at-least-32-random-characters"
# At least 32 random characters. Authorises POST /api/jobs/expire when a cron calls it instead of `npm run worker`.
CRON_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Set only behind a proxy which overwrites x-real-ip and prevents direct app access.
TRUST_PROXY="false"
# Request throttling is OFF unless set to "on". Accounts are never locked after failed sign-ins.
RATE_LIMITS=""

# ---- Seed accounts (npm run db:seed). In production both pairs must be set explicitly. ----
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-16-characters"
DRIVER_EMAIL=""
DRIVER_PASSWORD=""

# ---- Uploads (payment QR codes, vehicle photos, payment proofs) ----
# Leave S3_BUCKET empty to store files on the local disk under STORAGE_DIR (fine for one server; mount a volume).
# Set all four S3 variables (plus S3_ENDPOINT for Supabase/MinIO/R2) for a private bucket.
STORAGE_DIR="storage"
S3_REGION="ap-south-1"
S3_BUCKET=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---- Email (ticket confirmations and booking-tracking codes) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Sajilo Yatra <no-reply@example.com>"
# ---- SMS gateway (optional; HTTPS POST {to,message} with a bearer token) ----
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
# Development only: with no email or SMS configured, tracking codes are printed to the server console.
# Set OTP_CONSOLE="on" to allow that in production too (not recommended).
OTP_CONSOLE=""

# ---- Optional Supabase client (only used by /supabase-check) ----
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
